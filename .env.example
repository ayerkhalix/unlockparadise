# Mapbox public browser token (pk. prefix). Required for interactive maps.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Development only. Disabled whenever Supabase is configured.
# PHASE1_PREVIEW_TIER=explorer
# PHASE1_PREVIEW_TIER=explorer-plus

# Isolated backend. Never use production WordPress or a production Supabase project.
APP_URL=http://127.0.0.1:3000
UPD_ENVIRONMENT=staging
# fixtures is only permitted outside production. supabase never falls back on errors.
UPD_DATA_MODE=supabase
# Public legacy images only. Private images never redirect to this origin.
LEGACY_PUBLIC_MEDIA_BASE_URL=https://unlockparadise.ph/wp-content/uploads/
# Deployed staging uses an authorized placeholder until private Storage migration.
LEGACY_PRIVATE_MEDIA_MODE=unavailable
# Optional absolute uploads path, allowed only in staging with next dev.
LEGACY_PRIVATE_MEDIA_ROOT=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server / migration processes only. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
MIGRATION_PROJECT_REF=
# Generate at least 32 random characters locally for recovery grants and signed OAuth flow state.
AUTH_RECOVERY_SECRET=
# Google OAuth client ID/secret and business sender SMTP belong in Supabase Auth settings,
# not browser environment variables. Setup: docs/backend/AUTH_SETUP.md.
# Email is disabled by default. Staging sends only to explicitly approved test inboxes.
AUTH_EMAILS_ENABLED=false
AUTH_ALLOWED_EMAILS=
# Sandbox only. Live keys are rejected in application code and database constraints.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_TEST_USER_IDS=
PAYMONGO_TEST_METHODS=qrph
# Select xendit for its isolated, allowlisted membership test checkout.
PAYMENT_PROVIDER=paymongo
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_TEST_USER_IDS=
# Notifications require an approved transactional email adapter before dispatch.
NOTIFICATION_DELIVERY_ENABLED=false
# Optional, server-only. Enable Places API (New) in Google Cloud for nearby-place photos.
GOOGLE_PLACES_API_KEY=
