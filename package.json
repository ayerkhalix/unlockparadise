{
  "name": "unlock-paradise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:explorer": "node scripts/preview.mjs explorer",
    "dev:explorer-plus": "node scripts/preview.mjs explorer-plus",
    "demo:xendit": "node --env-file=.env.local --import tsx scripts/xendit-demo.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check:release": "node scripts/check-release.mjs",
    "test": "playwright test",
    "test:visual": "node scripts/visual-compare.mjs",
    "test:backend": "node --conditions=react-server --import tsx --test tests/integration/*.test.mjs tests/integration/*.test.ts",
    "test:staging": "node --env-file-if-exists=.env.local tests/staging.mjs",
    "test:staging:authenticated": "node --env-file-if-exists=.env.local tests/staging/acceptance.mjs",
    "staging:fixtures": "node --env-file-if-exists=.env.local scripts/staging-fixtures.mjs",
    "migration:storage-estimate": "node scripts/migration/storage-estimate.mjs",
    "test:backend-visual": "node scripts/backend-compare.mjs",
    "migration:audit": "python scripts/migration/audit.py",
    "migration:prepare": "python scripts/migration/prepare.py",
    "migration:content": "node --env-file-if-exists=.env.local scripts/migration/import-content.mjs",
    "migration:media": "node --env-file-if-exists=.env.local scripts/migration/media.mjs",
    "migration:reconcile": "node --env-file-if-exists=.env.local scripts/migration/reconcile.mjs",
    "migration:accounts": "node --env-file-if-exists=.env.local scripts/migration/accounts.mjs",
    "healthcheck": "node scripts/healthcheck.mjs",
    "import:wordpress": "python scripts/import_wordpress.py",
    "reference:audit": "python scripts/audit_references.py"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "mapbox-gl": "3.4.0",
    "next": "16.4.1",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "xss": "^1.0.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.1",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
